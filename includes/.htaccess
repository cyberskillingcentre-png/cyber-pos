RewriteEngine On


# -------------------------------
# ADMIN PAGES
# -------------------------------

# Core

RewriteRule ^Dashboard?$ dashboard.php 
RewriteRule ^Point_Of_Sale?$ pos.php 

# Inventory
RewriteRule ^Products?$ products.php 
RewriteRule ^Categories?$ categories.php 
RewriteRule ^Stock_Levels?$ inventory.php 
RewriteRule ^Stock_Purchases?$ purchases.php 
RewriteRule ^Expiring_Stock?$ expiring-products.php 

# Sales
RewriteRule ^Sales_Records?$ sales.php 
RewriteRule ^Sales_Returns?$ returns.php 

# Management
RewriteRule ^Customers?$ customers.php 
RewriteRule ^Suppliers?$ suppliers.php 
RewriteRule ^Branches?$ stores.php 
RewriteRule ^Users?$ users.php 



RewriteRule ^Client_Orders?$ Client_Orders.php 
RewriteRule ^Client_Management?$ Client_Management.php 


# Reports
RewriteRule ^Sales_Report?$ reports.php 
RewriteRule ^Inventory_Report?$ inventory-reports.php 
RewriteRule ^Expense_Report?$ expenses.php 

# Settings
RewriteRule ^System_Settings?$ settings.php 
RewriteRule ^My_Profile?$ profile.php 
RewriteRule ^Audit_Log?$ activity-logs.php 
