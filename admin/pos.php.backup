}

.btn-complete-sale:hover:not(:disabled)::before {
    width: 300px;
    height: 300px;
}

.btn-complete-sale:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(72, 187, 120, 0.5);
}

.btn-complete-sale:disabled {
    background: #CBD5E0;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
    opacity: 0.6;
}

.btn-complete-sale i {
    font-size: 1.25rem;
}

.btn-shortcut {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
