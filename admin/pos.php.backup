<?php
require_once '../config/config.php';
require_admin();

$page_title = "Point of Sale";

// Get active stores
$stmt = $conn->prepare("SELECT * FROM stores WHERE status = 'active' ORDER BY store_name");
$stmt->execute();
$stores = $stmt->fetchAll();

// Get payment methods
$payment_methods = ['cash', 'card', 'mobile_money', 'bank_transfer', 'credit'];

// Process sale
if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['complete_sale'])) {
    try {
        $conn->beginTransaction();
        
        $store_id = $_POST['store_id'];
        $customer_id = !empty($_POST['customer_id']) ? $_POST['customer_id'] : null;
        $payment_method = $_POST['payment_method'];
        $amount_paid = floatval($_POST['amount_paid']);
        $transaction_id = isset($_POST['transaction_id']) ? sanitize_input($_POST['transaction_id']) : null;
        $cart_items = json_decode($_POST['cart_items'], true);
        
        $sale_type = ($payment_method == 'credit') ? 'credit' : 'cash';
        
        if ($sale_type == 'credit' && !$customer_id) {
            throw new Exception('Customer is required for credit sales');
        }
        
        $subtotal = 0;
        $tax_amount = 0;
        $discount_amount = isset($_POST['discount_amount']) ? floatval($_POST['discount_amount']) : 0;
        
        foreach ($cart_items as $item) {
            $subtotal += $item['quantity'] * $item['price'];
            $tax_amount += $item['tax_amount'];
        }
        
        $total_amount = $subtotal + $tax_amount - $discount_amount;
        
        if ($payment_method != 'credit' && $amount_paid < $total_amount) {
            throw new Exception('Amount paid cannot be less than total amount');
        }
        
        $amount_due = $total_amount - $amount_paid;
        $payment_status = ($amount_paid >= $total_amount) ? 'paid' : ($amount_paid > 0 ? 'partial' : 'unpaid');
        
        $invoice_number = generate_invoice_number();
        
        $stmt = $conn->prepare("INSERT INTO sales (invoice_number, store_id, customer_id, sale_date, subtotal, discount_amount, tax_amount, total_amount, payment_method, payment_status, sale_type, amount_paid, amount_due, transaction_id, served_by, status) VALUES (?, ?, ?, NOW(), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'completed')");
        $stmt->execute([$invoice_number, $store_id, $customer_id, $subtotal, $discount_amount, $tax_amount, $total_amount, $payment_method, $payment_status, $sale_type, $amount_paid, $amount_due, $transaction_id, $_SESSION['user_id']]);
        $sale_id = $conn->lastInsertId();
        
        foreach ($cart_items as $item) {
            $profit = ($item['price'] - $item['cost']) * $item['quantity'];
            
            $stmt = $conn->prepare("INSERT INTO sale_items (sale_id, product_id, quantity, unit_price, discount_amount, tax_amount, total_price, profit) VALUES (?, ?, ?, ?, ?, ?, ?, ?)");
            $stmt->execute([$sale_id, $item['product_id'], $item['quantity'], $item['price'], 0, $item['tax_amount'], $item['quantity'] * $item['price'], $profit]);
            
            $remaining_qty = $item['quantity'];
            
            $stmt = $conn->prepare("SELECT inventory_id, quantity FROM store_inventory WHERE store_id = ? AND product_id = ? AND quantity > 0 ORDER BY last_updated ASC");
            $stmt->execute([$store_id, $item['product_id']]);
            $batches = $stmt->fetchAll();
            
            foreach ($batches as $batch) {
                if ($remaining_qty <= 0) break;
                
                if ($batch['quantity'] >= $remaining_qty) {
                    $stmt = $conn->prepare("UPDATE store_inventory SET quantity = GREATEST(quantity - ?, 0) WHERE inventory_id = ?");
                    $stmt->execute([$remaining_qty, $batch['inventory_id']]);
                    $remaining_qty = 0;
                } else {
                    $stmt = $conn->prepare("UPDATE store_inventory SET quantity = 0 WHERE inventory_id = ?");
                    $stmt->execute([$batch['inventory_id']]);
                    $remaining_qty -= $batch['quantity'];
                }
            }
        }
        
        if ($customer_id) {
            $stmt = $conn->prepare("UPDATE customers SET total_purchases = total_purchases + ? WHERE customer_id = ?");
            $stmt->execute([$total_amount, $customer_id]);
        }
        
        $sale_type_label = ($sale_type == 'credit') ? 'credit sale' : 'cash sale';
        log_activity($_SESSION['user_id'], 'SALE_CREATED', "Created $sale_type_label $invoice_number for UGX " . format_currency($total_amount), $conn);
        
        $conn->commit();

        if ($sale_type == 'credit') {
            set_alert('success', 'Credit sale completed! Invoice: ' . $invoice_number);
            header('Location: Credit_Invoice?id=' . $sale_id);
        } else {
            set_alert('success', 'Sale completed successfully! Invoice: ' . $invoice_number);
            header('Location: Receipt?id=' . $sale_id);
        }
        exit();
        
    } catch(Exception $e) {
        if (isset($conn)) $conn->rollBack();
        set_alert('danger', 'Error: ' . $e->getMessage());
    }
}
?>

