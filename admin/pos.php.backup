    font-weight: 700;
    font-family: 'Courier New', monospace;
}

/* Keyboard Shortcuts */
.keyboard-shortcuts {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid #E2E8F0;
    flex-wrap: wrap;
}

.shortcut-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    color: #A0AEC0;
}

.shortcut-key {
