    margin-top: 12px;
    animation: popIn 0.3s ease;
}

@keyframes popIn {
    0% { transform: scale(0.95); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
}

.change-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #2F855A;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.change-value {
