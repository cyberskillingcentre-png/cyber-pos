    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-weight: 700;
    color: #4A5568;
    font-size: 0.65rem;
}

/* Responsive */
@media (max-width: 991.98px) {
    .pos-summary-card {
        position: static;
        margin-top: 20px;
    }
    
    .search-hints {
        display: none;
    }
    
    .payment-methods-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 767.98px) {
    .pos-clock, .pos-date {
        display: none;
    }
    
    .payment-methods-grid {
        grid-template-columns: repeat(3, 1fr);
    }
    
    .store-selector {
        flex-direction: column;
        align-items: stretch;
    }
    
    .store-icon {
        display: none;
    }
    
    .pos-cart-table {
        font-size: 0.8rem;
    }
    
    .pos-cart-table tbody td {
        padding: 10px 8px;
    }
}

/* Scrollbar */
.search-results-list::-webkit-scrollbar,
.pos-cart-body::-webkit-scrollbar {
    width: 6px;
}

.search-results-list::-webkit-scrollbar-track,
.pos-cart-body::-webkit-scrollbar-track {
    background: #F7FAFC;
}

.search-results-list::-webkit-scrollbar-thumb,
.pos-cart-body::-webkit-scrollbar-thumb {
    background: #6B46C1;
    border-radius: 3px;
}

.search-results-list::-webkit-scrollbar-thumb:hover,
.pos-cart-body::-webkit-scrollbar-thumb:hover {
    background: #553C9A;
}
</style>

<?php include '../includes/footer.php'; ?>

<script>
let cart = [];
let storeId = null;
let selectedProductIndex = -1;
let productsData = [];
let selectedPaymentMethod = '';

jQuery(document).ready(function($) {
    console.log('CyberPlaza POS loaded');
    
    // ============================================
    // LIVE CLOCK
    // ============================================
    function updateClock() {
        const now = new Date();
        const time = now.toLocaleTimeString('en-US', { hour12: false });
        $('#live-clock').text(time);
    }
    setInterval(updateClock, 1000);
    updateClock();
    
    // ============================================
    // LOAD CUSTOMERS
    // ============================================
    $.ajax({
        url: '../includes/ajax_customers.php',
        method: 'GET',
        dataType: 'json',
        success: function(data) {
            data.forEach(function(customer) {
                $('#customer-select').append(new Option(customer.customer_name + ' - ' + customer.phone, customer.customer_id));
            });
        },
        error: function(xhr, status, error) {
            console.error('Error loading customers:', error);
        }
    });
    
    // ============================================
    // PAYMENT METHOD SELECTION (Custom UI)
    // ============================================
    $('.payment-method-option').on('click', function() {
        $('.payment-method-option').removeClass('selected');
        $(this).addClass('selected');
        
        selectedPaymentMethod = $(this).data('value');
        $('#payment-method').val(selectedPaymentMethod);
        
        updatePaymentUI(selectedPaymentMethod);
        updateCompleteButton();
    });
    
    function updatePaymentUI(paymentMethod) {
        if (paymentMethod == 'credit') {
            $('#payment-section').show();
            $('#credit-notice').show();
            $('#customer-required').show();
            $('#transaction-id-section').hide();
            $('#transaction-id').removeAttr('required');
            $('#amount-paid').val(0).removeAttr('required');
        } else if (paymentMethod == 'mobile_money') {
            $('#payment-section').show();
            $('#credit-notice').hide();
            $('#customer-required').hide();
            $('#transaction-id-section').show();
            $('#transaction-id').attr('required', true);
            $('#amount-paid').attr('required', true);
        } else {
            $('#payment-section').show();
            $('#credit-notice').hide();
            $('#customer-required').hide();
            $('#transaction-id-section').hide();
            $('#transaction-id').removeAttr('required');
            $('#amount-paid').attr('required', true);
        }
        
        calculateChange();
    }
    
    // ============================================
    // AUTO-FILL BUTTON
    // ============================================
    $('#auto-fill-btn').on('click', function() {
        const total = parseFloat($('#total-value').val()) || 0;
        $('#amount-paid').val(total.toFixed(2));
        calculateChange();
        updateCompleteButton();
    });
    
    // ============================================
    // PRODUCT SEARCH
    // ============================================
    let searchTimeout;
    
    $('#product-search').on('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            if (selectedProductIndex >= 0 && productsData[selectedProductIndex]) {
                const product = productsData[selectedProductIndex];
                if (product.quantity > 0) {
                    addToCart(product.product_id, product.product_name, product.selling_price, product.purchase_price, product.tax_rate, product.quantity);
                }
            } else {
                searchProducts();
            }
        } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            navigateProducts(e.key);
        } else if (e.key === 'Escape') {
            clearSearchResults();
        }
    });
    
    $('#product-search').on('input', function() {
        clearTimeout(searchTimeout);
        const query = $(this).val();
        
        if (query.length >= 2) {
            searchTimeout = setTimeout(searchProducts, 300);
        } else if (query.length === 0) {
            clearSearchResults();
        }
    });
    
    // ============================================
    // STORE SELECTION
    // ============================================
    $('#store-select').on('change', function() {
        storeId = $(this).val();
        
        if (storeId) {
            $('#store-status').html('<span class="status-dot-active"></span><span>Store Active</span>');
            $('#store-status').css('background', 'rgba(72, 187, 120, 0.15)');
            $('#store-status').css('color', '#2F855A');
            $('#product-search').focus();
        } else {
            $('#store-status').html('<span class="status-dot-inactive"></span><span>Not Selected</span>');
            $('#store-status').css('background', '#EDF2F7');
            $('#store-status').css('color', '#718096');
        }
        
        updateCompleteButton();
    });
    
    // ============================================
    // DISCOUNT INPUT
    // ============================================
    $('#discount-input').on('input', function() {
        updateTotals();
    });
    
    // ============================================
    // AMOUNT PAID
    // ============================================
    $('#amount-paid').on('input', function() {
        const paymentMethod = $('#payment-method').val();
        const total = parseFloat($('#total-value').val()) || 0;
        const paid = parseFloat($(this).val()) || 0;
        
        if (paymentMethod != 'credit') {
            if (paid < total) {
                $('#amount-error').removeClass('d-none');
                $('#complete-sale-btn').prop('disabled', true);
            } else {
                $('#amount-error').addClass('d-none');
                updateCompleteButton();
            }
        }
        
        calculateChange();
    });
    
    // ============================================
    // CLEAR CART
    // ============================================
    $('#clear-cart').on('click', function() {
        if (cart.length === 0) return;
        
        Swal.fire({
            title: 'Clear Cart?',
            text: 'All items will be removed from the cart.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#E53E3E',
            cancelButtonColor: '#718096',
            confirmButtonText: 'Yes, Clear',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                cart = [];
                updateCart();
                showToast('Cart cleared', 'info');
            }
        });
    });
    
    // ============================================
    // FORM SUBMISSION
    // ============================================
    $('#sale-form').on('submit', function(e) {
        if (!storeId) {
            e.preventDefault();
            showToast('Please select a store', 'warning');
            return false;
        }
        if (cart.length === 0) {
            e.preventDefault();
            showToast('Cart is empty', 'warning');
            return false;
        }
        
        const paymentMethod = $('#payment-method').val();
        if (!paymentMethod) {
            e.preventDefault();
            showToast('Please select a payment method', 'warning');
            return false;
        }
        
        if (paymentMethod == 'credit' && !$('#customer-select').val()) {
            e.preventDefault();
            showToast('Customer is required for credit sales', 'warning');
            return false;
        }
        
        if (paymentMethod == 'mobile_money' && !$('#transaction-id').val()) {
            e.preventDefault();
            showToast('Transaction ID is required', 'warning');
            return false;
        }
        
        const total = parseFloat($('#total-value').val()) || 0;
        const paid = parseFloat($('#amount-paid').val()) || 0;
        
        if (paymentMethod != 'credit' && paid < total) {
            e.preventDefault();
            showToast('Amount paid cannot be less than total', 'warning');
            return false;
        }
        
        $('#cart-items-input').val(JSON.stringify(cart));
    });
    
    // ============================================
    // KEYBOARD SHORTCUTS
    // ============================================
    $(document).on('keydown', function(e) {
        if (e.key === 'F2') {
            e.preventDefault();
            $('#product-search').focus();
        } else if (e.key === 'F4') {
            e.preventDefault();
            $('#clear-cart').click();
        } else if (e.key === 'F12') {
            e.preventDefault();
            if (!$('#complete-sale-btn').prop('disabled')) {
                $('#sale-form').submit();
            }
        }
    });
});

// ============================================
// SEARCH PRODUCTS
// ============================================
function searchProducts() {
    const query = jQuery('#product-search').val();
    const store_id = jQuery('#store-select').val();
    
    if (!store_id) {
        showToast('Please select a store first', 'warning');
        return;
    }
    
    if (query.length < 2) return;
    
    jQuery.ajax({
        url: '../includes/ajax_search_products.php',
        method: 'POST',
        data: { query: query, store_id: store_id },
        dataType: 'json',
        success: function(products) {
            if (products.error) {
                jQuery('#search-results').html('<div class="alert alert-danger m-3">' + products.error + '</div>');
                jQuery('#search-results-container').show();
                return;
            }
            
            if (products.length === 0) {
                jQuery('#search-results').html('<div class="empty-cart p-4"><i class="fas fa-search"></i><h5>No Products Found</h5><p>Try a different search term</p></div>');
                jQuery('#search-results-container').show();
                productsData = [];
                selectedProductIndex = -1;
                return;
            }
            
            productsData = products;
            selectedProductIndex = products.length > 0 ? 0 : -1;
            renderProducts();
            jQuery('#search-results-container').show();
        },
        error: function(xhr, status, error) {
            console.error('AJAX Error:', error);
            showToast('Error searching products', 'error');
        }
    });
}

// ============================================
// RENDER PRODUCTS
// ============================================
function renderProducts() {
    let html = '';
    productsData.forEach(function(product, index) {
        const outOfStock = product.quantity <= 0;
        const selectedClass = index === selectedProductIndex ? 'selected' : '';
        const disabledClass = outOfStock ? 'out-of-stock' : '';
        
        let stockClass = 'stock-good';
        if (outOfStock) stockClass = 'stock-out';
        else if (product.quantity <= 10) stockClass = 'stock-low';
        
        const onclick = outOfStock ? '' : `onclick="addToCart(${product.product_id}, '${product.product_name.replace(/'/g, "\\'")}', ${product.selling_price}, ${product.purchase_price}, ${product.tax_rate}, ${product.quantity})"`;
        
        html += `
            <div class="product-item ${selectedClass} ${disabledClass}" data-index="${index}" ${onclick}>
                <div class="product-info">
                    <div class="product-name">${product.product_name}</div>
                    <div class="product-code">
                        <i class="fas fa-barcode me-1"></i>${product.product_code}
                    </div>
                </div>
                <div class="product-details">
                    <div class="product-price">UGX ${parseFloat(product.selling_price).toFixed(2)}</div>
                    <span class="stock-badge ${stockClass}">
                        ${outOfStock ? '❌ Out of Stock' : '📦 Stock: ' + product.quantity}
                    </span>
                </div>
            </div>
        `;
    });
    jQuery('#search-results').html(html);
}

// ============================================
// NAVIGATE PRODUCTS
// ============================================
function navigateProducts(key) {
    if (productsData.length === 0) return;
    
    if (key === 'ArrowDown') {
        selectedProductIndex = (selectedProductIndex + 1) % productsData.length;
    } else if (key === 'ArrowUp') {
        selectedProductIndex = selectedProductIndex <= 0 ? productsData.length - 1 : selectedProductIndex - 1;
    }
    
    renderProducts();
    
    const selectedElement = jQuery('.product-item.selected');
    if (selectedElement.length > 0) {
        selectedElement[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
}

// ============================================
// CLEAR SEARCH RESULTS
// ============================================
function clearSearchResults() {
    jQuery('#search-results-container').hide();
    jQuery('#search-results').html('');
    productsData = [];
    selectedProductIndex = -1;
}

// ============================================
// ADD TO CART
// ============================================
function addToCart(productId, productName, price, cost, taxRate, availableQty) {
    if (availableQty <= 0) {
        showToast('Product is out of stock', 'warning');
        return;
    }
    
    const existingItem = cart.find(item => item.product_id === productId);
    
    if (existingItem) {
        if (existingItem.quantity < availableQty) {
            existingItem.quantity++;
            showToast(`${productName} - Qty: ${existingItem.quantity}`, 'success');
        } else {
            showToast('Stock limit reached', 'warning');
            return;
        }
    } else {
        cart.push({
            product_id: productId,
            product_name: productName,
            price: parseFloat(price),
            cost: parseFloat(cost),
            tax_rate: parseFloat(taxRate),
            quantity: 1,
            available_qty: parseInt(availableQty)
        });
        showToast(`${productName} added to cart`, 'success');
    }
    
    updateCart();
    clearSearchResults();
    jQuery('#product-search').val('').focus();
}

// ============================================
// REMOVE FROM CART
// ============================================
function removeFromCart(index) {
    const item = cart[index];
    cart.splice(index, 1);
    updateCart();
    showToast(`${item.product_name} removed`, 'info');
}

// ============================================
// UPDATE QUANTITY
// ============================================
function updateQuantity(index, newQty) {
    if (newQty > 0 && newQty <= cart[index].available_qty) {
        cart[index].quantity = parseInt(newQty);
        updateCart();
    } else if (newQty > cart[index].available_qty) {
        showToast('Quantity exceeds available stock', 'warning');
        updateCart(); // Reset to previous value
    }
}

// ============================================
// UPDATE CART
// ============================================
function updateCart() {
    let html = '';
    
    // Update cart count
    jQuery('#cart-count').text(cart.length);
    
    if (cart.length === 0) {
        html = `
            <tr class="empty-cart-row">
                <td colspan="6">
                    <div class="empty-cart">
                        <i class="fas fa-shopping-basket"></i>
                        <h5>Cart is Empty</h5>
                        <p>Search and add products to begin a sale</p>
                    </div>
                </td>
            </tr>
        `;
    } else {
        cart.forEach(function(item, index) {
            const taxAmount = (item.price * item.quantity * item.tax_rate / 100);
            item.tax_amount = taxAmount;
            const subtotal = item.price * item.quantity;
            
            html += `
                <tr>
                    <td>
                        <div class="cart-product-name">${item.product_name}</div>
                        <div class="cart-product-code">${item.product_id}</div>
                    </td>
                    <td>
                        <span style="font-family: 'Courier New', monospace; font-weight: 600;">
                            ${item.price.toFixed(2)}
                        </span>
                    </td>
                    <td>
                        <input type="number" class="cart-qty-input" 
                               value="${item.quantity}" min="1" max="${item.available_qty}" 
                               onchange="updateQuantity(${index}, this.value)">
                    </td>
                    <td>
                        <span style="font-family: 'Courier New', monospace; color: #718096; font-size: 0.8rem;">
                            ${taxAmount.toFixed(2)}
                        </span>
                    </td>
                    <td>
                        <span style="font-family: 'Courier New', monospace; font-weight: 700; color: #6B46C1;">
                            ${subtotal.toFixed(2)}
                        </span>
                    </td>
                    <td>
                        <button type="button" class="btn-remove-item" onclick="removeFromCart(${index})">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
        });
    }
    
    jQuery('#cart-items').html(html);
    updateTotals();
}

// ============================================
// UPDATE TOTALS
// ============================================
function updateTotals() {
    let subtotal = 0;
    let taxTotal = 0;
    
    cart.forEach(function(item) {
        subtotal += item.price * item.quantity;
        taxTotal += item.tax_amount;
    });
    
    const discount = parseFloat(jQuery('#discount-input').val()) || 0;
    const total = subtotal + taxTotal - discount;
    
    jQuery('#subtotal-display').text('UGX ' + subtotal.toFixed(2));
    jQuery('#tax-display').text('UGX ' + taxTotal.toFixed(2));
    jQuery('#total-display').text('UGX ' + total.toFixed(2));
    jQuery('#total-value').val(total.toFixed(2));
    
    calculateChange();
    updateCompleteButton();
}

// ============================================
// CALCULATE CHANGE
// ============================================
function calculateChange() {
    const total = parseFloat(jQuery('#total-value').val()) || 0;
    const paid = parseFloat(jQuery('#amount-paid').val()) || 0;
    const change = paid - total;
    
    if (change > 0) {
        jQuery('#change-display').text('UGX ' + change.toFixed(2));
        jQuery('#change-container').show();
    } else {
        jQuery('#change-container').hide();
    }
}

// ============================================
// UPDATE COMPLETE BUTTON
// ============================================
function updateCompleteButton() {
    const hasStore = storeId !== null && storeId !== '';
    const hasItems = cart.length > 0;
    const paymentMethod = jQuery('#payment-method').val();
    const total = parseFloat(jQuery('#total-value').val()) || 0;
    const paid = parseFloat(jQuery('#amount-paid').val()) || 0;
    
    let canComplete = hasStore && hasItems && paymentMethod;
    
    if (paymentMethod && paymentMethod != 'credit') {
        canComplete = canComplete && (paid >= total);
    }
    
    jQuery('#complete-sale-btn').prop('disabled', !canComplete);
}

// ============================================
// TOAST NOTIFICATIONS
// ============================================
function showToast(message, type = 'info') {
    const icons = {
        success: 'check-circle',
        warning: 'exclamation-triangle',
        error: 'times-circle',
        info: 'info-circle'
    };
    
    const colors = {
        success: '#48BB78',
        warning: '#ED8936',
        error: '#E53E3E',
        info: '#6B46C1'
    };
    
    // Remove existing toast
    jQuery('.pos-toast').remove();
    
    const toast = jQuery(`
        <div class="pos-toast" style="
            position: fixed;
            top: 80px;
            right: 20px;
            background: white;
            padding: 14px 20px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border-left: 4px solid ${colors[type]};
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 9999;
            animation: slideInRight 0.3s ease;
            min-width: 250px;
            font-weight: 600;
            color: #1A202C;
        ">
            <i class="fas fa-${icons[type]}" style="color: ${colors[type]}; font-size: 1.2rem;"></i>
            <span>${message}</span>
        </div>
    `);
    
    jQuery('body').append(toast);
    
    setTimeout(() => {
        toast.css('animation', 'slideOutRight 0.3s ease');
        setTimeout(() => toast.remove(), 300);
    }, 2500);
}
</script>

<style>
@keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

@keyframes slideOutRight {
    from { transform: translateX(0); opacity: 1; }
    to { transform: translateX(100%); opacity: 0; }
}
</style>