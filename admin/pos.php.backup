    color: white;
    border-color: #553C9A;
    box-shadow: 0 6px 20px rgba(107, 70, 193, 0.35);
}

.product-item.selected .product-name,
.product-item.selected .product-code,
.product-item.selected .product-price,
.product-item.selected .product-stock {
    color: white !important;
}

.product-item.selected .stock-badge {
    background: rgba(255, 255, 255, 0.2);
    color: white;
}

.product-item.out-of-stock {
    opacity: 0.5;
    cursor: not-allowed;
    background: #F7FAFC;
}

.product-item.out-of-stock:hover {
    background: #F7FAFC;
    transform: none;
    border-color: #E2E8F0;
    box-shadow: none;
}

.product-info {
    flex: 1;
    min-width: 0;
}

.product-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: #1A202C;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.product-code {
    font-size: 0.75rem;
    color: #718096;
    font-family: 'Courier New', monospace;
    font-weight: 600;
}

.product-details {
    text-align: right;
    flex-shrink: 0;
}

.product-price {
    font-weight: 700;
    font-size: 1rem;
    color: #6B46C1;
    margin-bottom: 4px;
}

.stock-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 0.7rem;
    font-weight: 700;
    background: #EDF2F7;
    color: #4A5568;
}

.stock-badge.stock-good {
    background: rgba(72, 187, 120, 0.15);
    color: #2F855A;
}

.stock-badge.stock-low {
    background: rgba(237, 137, 54, 0.15);
    color: #C05621;
}

.stock-badge.stock-out {
    background: rgba(229, 62, 62, 0.15);
    color: #C53030;
}

/* Cart Card */
.pos-cart-card {
    background: #FFFFFF;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    border: 1px solid #E2E8F0;
    overflow: hidden;
}

.pos-cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: linear-gradient(135deg, #1A202C, #2D3748);
    color: white;
}

.cart-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1rem;
}

.cart-title i {
    color: #ED8936;
    font-size: 1.1rem;
}

.cart-count {
    background: #ED8936;
    color: white;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
