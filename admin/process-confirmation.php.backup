<?php
session_start();
require_once '../config/config.php';
require_login();
if (!is_admin()) { header('Location: ../employee/dashboard.php'); exit(); }

if ($_SERVER['REQUEST_METHOD'] != 'POST') {
    header('Location: Client_Orders');
    exit;
}

$order_id = intval($_POST['order_id']);
$store_id = intval($_POST['store_id']); // 0 means "All Stores"
$payment_type = $_POST['payment_type'];
$amount_paid = floatval($_POST['amount_paid'] ?? 0);
$transaction_notes = trim($_POST['transaction_notes'] ?? '');
$send_invoice = isset($_POST['send_invoice']);

try {
    $conn->beginTransaction();
    
    // Get order details
    $stmt = $conn->prepare("
        SELECT co.*, u.email as client_email, u.full_name as client_name
        FROM client_orders co
        LEFT JOIN users u ON co.client_id = u.user_id
        WHERE co.order_id = ? AND co.order_status = 'pending'
    ");
    $stmt->execute([$order_id]);
    $order = $stmt->fetch(PDO::FETCH_ASSOC);
    
    if (!$order) {
        throw new Exception('Order not found or already processed');
    }
    
    // Get order items
    $stmt = $conn->prepare("
        SELECT coi.*, p.product_name 
        FROM client_order_items coi
        LEFT JOIN products p ON coi.product_id = p.product_id
        WHERE coi.order_id = ?
    ");
    $stmt->execute([$order_id]);
    $items = $stmt->fetchAll(PDO::FETCH_ASSOC);
    
    // VALIDATE STOCK AVAILABILITY
    if ($store_id > 0) {
        // Single store validation
        $stock_errors = [];
        foreach ($items as $item) {
            $stmt = $conn->prepare("
                SELECT COALESCE(SUM(quantity), 0) as available
                FROM store_inventory
                WHERE product_id = ? AND store_id = ?
            ");
            $stmt->execute([$item['product_id'], $store_id]);
            $available = $stmt->fetchColumn();
            
            if ($available < $item['quantity']) {
                $stock_errors[] = $item['product_name'] . " (Available: $available, Required: {$item['quantity']})";
            }
        }
        
        if (!empty($stock_errors)) {
            throw new Exception('INSUFFICIENT STOCK: ' . implode(', ', $stock_errors));
        }
    } else {
        // All stores validation
        $stock_errors = [];
        foreach ($items as $item) {
            $stmt = $conn->prepare("
                SELECT COALESCE(SUM(quantity), 0) as available
                FROM store_inventory
                WHERE product_id = ?
            ");
            $stmt->execute([$item['product_id']]);
            $available = $stmt->fetchColumn();
            
            if ($available < $item['quantity']) {
                $stock_errors[] = $item['product_name'] . " (Total Available: $available, Required: {$item['quantity']})";
            }
        }
        
        if (!empty($stock_errors)) {
            throw new Exception('INSUFFICIENT TOTAL STOCK: ' . implode(', ', $stock_errors));
        }
    }
    
    // Calculate payment status and amounts
    if ($payment_type == 'paid') {
        $payment_status = 'paid';
        $amount_paid = $order['grand_total'];
    } elseif ($payment_type == 'credit') {
        $payment_status = 'pending';
        $amount_paid = 0;
    } else { // partial
        if ($amount_paid <= 0 || $amount_paid > $order['grand_total']) {
            throw new Exception('Invalid payment amount');
        }
        $payment_status = 'partial';
    }
    
    // Determine final store_id for order record
    $final_store_id = $store_id > 0 ? $store_id : null;
    
    // Update order status
    $stmt = $conn->prepare("
        UPDATE client_orders 
        SET order_status = 'confirmed',
            payment_status = ?,
            amount_paid = ?,
            store_id = ?,
            notes = CONCAT(COALESCE(notes, ''), '\n\n[Admin] ', ?),
            processed_by = ?,
            updated_at = CURRENT_TIMESTAMP
        WHERE order_id = ?
    ");
    $stmt->execute([
        $payment_status,
        $amount_paid,
        $final_store_id,
        $transaction_notes . ($store_id == 0 ? ' [Multi-store FIFO]' : ''),
        $_SESSION['user_id'],
        $order_id
    ]);
    
    // DEDUCT INVENTORY using FIFO method (using inventory_id as chronological proxy)
    foreach ($items as $item) {
        $remaining_qty = $item['quantity'];
        
        // Get batches ordered by inventory_id (proxy for chronological order)
        if ($store_id > 0) {
            // Single store
            $stmt = $conn->prepare("
                SELECT inventory_id, quantity, store_id
                FROM store_inventory 
                WHERE product_id = ? AND store_id = ? AND quantity > 0
                ORDER BY inventory_id ASC
            ");
            $stmt->execute([$item['product_id'], $store_id]);
        } else {
            // All stores - FIFO across all stores
            $stmt = $conn->prepare("
                SELECT inventory_id, quantity, store_id
                FROM store_inventory 
                WHERE product_id = ? AND quantity > 0
                ORDER BY inventory_id ASC
            ");
            $stmt->execute([$item['product_id']]);
        }
        
        $batches = $stmt->fetchAll(PDO::FETCH_ASSOC);
        
        foreach ($batches as $batch) {
            if ($remaining_qty <= 0) break;
            
            $deduct_qty = min($remaining_qty, $batch['quantity']);
            
            // Deduct from this batch
            $stmt = $conn->prepare("
                UPDATE store_inventory 
                SET quantity = quantity - ? 
                WHERE inventory_id = ?
            ");
            $stmt->execute([$deduct_qty, $batch['inventory_id']]);
            
            $remaining_qty -= $deduct_qty;
        }
        
        // Safety check
        if ($remaining_qty > 0) {
            throw new Exception('Failed to deduct full quantity for ' . $item['product_name']);
        }
    }
    
    // RECORD TRANSACTION in sales table
    $sales_store_id = $store_id > 0 ? $store_id : null;
    
    $stmt = $conn->prepare("
        INSERT INTO sales (
            sale_date, 
            customer_id, 
            store_id, 
            total_amount, 
            discount, 
            grand_total, 
            payment_method, 
            payment_status,
            amount_paid,
            user_id,
            notes
        ) VALUES (NOW(), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    ");
    $stmt->execute([
        $order['client_id'],
        $sales_store_id,
        $order['total_amount'],
        $order['discount_amount'],
        $order['grand_total'],
        $order['payment_method'],
        $payment_status,
        $amount_paid,
        $_SESSION['user_id'],
        'Client Order: ' . $order['order_number'] . ($store_id == 0 ? ' [Multi-store]' : '')
    ]);
    $sale_id = $conn->lastInsertId();
    
    // Record sale items
    foreach ($items as $item) {
        $stmt = $conn->prepare("
            INSERT INTO sale_items (
                sale_id, 
                product_id, 
                quantity, 
                unit_price, 
                discount, 
                total_price,
                profit
            ) VALUES (?, ?, ?, ?, ?, ?, 0)
        ");
        
        $stmt->execute([
            $sale_id,
            $item['product_id'],
            $item['quantity'],
            $item['unit_price'],
            $item['discount'],
            $item['total_price']
        ]);
    }
    
    // Update client balance if credit/partial
    if ($payment_type == 'credit') {
        $stmt = $conn->prepare("
            UPDATE client_profiles 
            SET current_balance = current_balance + ?
            WHERE user_id = ?
        ");
        $stmt->execute([$order['grand_total'], $order['client_id']]);
    } elseif ($payment_type == 'partial') {
        $balance_to_add = $order['grand_total'] - $amount_paid;
        $stmt = $conn->prepare("
            UPDATE client_profiles 
            SET current_balance = current_balance + ?
            WHERE user_id = ?
        ");
        $stmt->execute([$balance_to_add, $order['client_id']]);
    }
    
    $conn->commit();
    
    // SEND INVOICE EMAIL
    if ($send_invoice && $order['client_email']) {
        try {
            $stmt = $conn->prepare("SELECT * FROM client_order_items WHERE order_id = ?");
            $stmt->execute([$order_id]);
            $invoice_items = $stmt->fetchAll(PDO::FETCH_ASSOC);
            
            $items_html = '';
            foreach ($invoice_items as $item) {
                $items_html .= "<tr>
                    <td>" . htmlspecialchars($item['product_name']) . "</td>
                    <td>{$item['quantity']}</td>
                    <td>UGX " . number_format($item['unit_price'], 0) . "</td>
                    <td>UGX " . number_format($item['total_price'], 0) . "</td>
                </tr>";
            }
            
            $to = $order['client_email'];
            $subject = "Order Confirmed - Invoice " . $order['order_number'];
            
            $message = "
<!DOCTYPE html>
<html>
<head>
<style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: linear-gradient(135deg, #6B46C1, #805AD5); color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0; }
    .content { background: #f9f9f9; padding: 20px; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; background: white; }
    th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
    th { background: #6B46C1; color: white; }
    .total { font-size: 18px; font-weight: bold; text-align: right; padding: 15px; background: #f0f0f0; }
    .footer { text-align: center; margin-top: 20px; color: #666; font-size: 12px; }
</style>
</head>
<body>
<div class='container'>
    <div class='header'>
        <h1>Order Confirmed!</h1>
        <p>" . htmlspecialchars($_SESSION['org_name']) . "</p>
    </div>
    <div class='content'>
        <h2>Dear " . htmlspecialchars($order['client_name']) . ",</h2>
        <p>Your order has been confirmed and is being processed. Here are the details:</p>
        
        <table>
            <tr>
                <td><strong>Order Number:</strong></td>
                <td>" . htmlspecialchars($order['order_number']) . "</td>
            </tr>
            <tr>
                <td><strong>Order Date:</strong></td>
                <td>" . date('M d, Y H:i', strtotime($order['order_date'])) . "</td>
            </tr>
            <tr>
                <td><strong>Payment Status:</strong></td>
                <td>" . ucfirst($payment_status) . "</td>
            </tr>
        </table>
        
        <h3>Order Items:</h3>
        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                $items_html
            </tbody>
        </table>
        
        <div class='total'>
            Grand Total: UGX " . number_format($order['grand_total'], 0) . "<br>
            Amount Paid: UGX " . number_format($amount_paid, 0) . "<br>
            Balance: UGX " . number_format($order['grand_total'] - $amount_paid, 0) . "
        </div>
        
        <p>You can view your invoice anytime by logging into your account.</p>
        <p>Thank you for your business!</p>
    </div>
    <div class='footer'>
        <p>" . htmlspecialchars($_SESSION['org_name']) . "</p>
    </div>
</div>
</body>
</html>
            ";
            
            $headers = "MIME-Version: 1.0\r\n";
            $headers .= "Content-type:text/html;charset=UTF-8\r\n";
            $headers .= "From: " . ($_SESSION['org_email'] ?? 'noreply@example.com') . "\r\n";
            
            mail($to, $subject, $message, $headers);
            
        } catch(Exception $e) {
            error_log("Invoice email error: " . $e->getMessage());
        }
    }
    
    set_alert('success', 'Order confirmed successfully! Inventory deducted' . ($store_id == 0 ? ' from multiple stores using FIFO' : '') . ', transaction recorded, and invoice sent to client.');
    header('Location: View_Order?id=' . $order_id);
    exit;
    
} catch(Exception $e) {
    if (isset($conn)) {
        $conn->rollBack();
    }
    set_alert('danger', 'Error confirming order: ' . $e->getMessage());
    header('Location: Confirm_Order?id=' . $order_id);
    exit;
}
